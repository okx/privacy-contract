# ==========================================
# Privacy Contract Configuration
# ==========================================

# Circuit configuration
USE_LOCAL_CIRCUITS=false
CIRCUITS_V2_DIR=

# ==========================================
# Network Mode
# ==========================================

# Local mode (REQUIRED)
# If set to true, will use local network settings
# If set to false, ALL following online network variables are REQUIRED
LOCAL=true

# ==========================================
# Local Network Configuration (when LOCAL=true)
# ==========================================

# Local RPC URL (OPTIONAL when LOCAL=true)
# Default: http://127.0.0.1:8545
LOCAL_RPC=

# ==========================================
# Online Network Configuration (REQUIRED when LOCAL=false)
# ==========================================

# RPC URL (REQUIRED when LOCAL=false)
# Examples:
#   - Sepolia: https://sepolia.infura.io/v3/YOUR_API_KEY
#   - X Layer: https://testrpc.xlayer.tech
#   - Polygon: https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
RPC_URL=

# Chain ID (REQUIRED when LOCAL=false)
# Common values:
#   1 - Ethereum Mainnet
#   11155111 - Sepolia Testnet
#   1952 - X Layer Testnet
#   137 - Polygon Mainnet
#   42161 - Arbitrum One
CHAIN_ID=

# ==========================================
# Account Configuration (REQUIRED when LOCAL=false)
# ==========================================

# Deployer private key (REQUIRED when LOCAL=false)
DEPLOYER_PRIVATE_KEY=

# Broadcaster private key (REQUIRED when LOCAL=false)
BROADCASTER_PRIVATE_KEY=

# ==========================================
# Optional Configuration
# ==========================================

# Block Explorer URL (OPTIONAL)
# Used for "View on Explorer" links in the UI
# Examples:
#   - Sepolia: https://sepolia.etherscan.io
#   - X Layer: https://www.okx.com/web3/explorer/xlayer-test
#   - Polygon: https://polygonscan.com
BLOCK_EXPLORER_URL=

# Etherscan API Key (OPTIONAL)
# Only needed if you want to verify contracts on Etherscan
ETHERSCAN_API_KEY=

# ==========================================
# Example Configurations
# ==========================================

# Example 1: 本地开发
# LOCAL=true

# Example 2: X Layer 测试网
# LOCAL=false
# RPC_URL=https://testrpc.xlayer.tech
# CHAIN_ID=1952
# DEPLOYER_PRIVATE_KEY=0x...
# BROADCASTER_PRIVATE_KEY=0x...
# BLOCK_EXPLORER_URL=https://www.okx.com/web3/explorer/xlayer-test

# Example 3: Sepolia 测试网
# LOCAL=false
# RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
# CHAIN_ID=11155111
# DEPLOYER_PRIVATE_KEY=0x...
# BROADCASTER_PRIVATE_KEY=0x...
# BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
# ETHERSCAN_API_KEY=YOUR_KEY
