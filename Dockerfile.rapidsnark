FROM ubuntu:22.04 AS base

ARG RAPIDSNARK_REPO=https://github.com/okx/rapidsnark.git
ARG RAPIDSNARK_BRANCH=cliff/dev/railgun_circuit
ARG RAPIDSNARK_CIRCUIT=01x02

ENV DEBIAN_FRONTEND=noninteractive

# Use Aliyun mirror for faster downloads
RUN sed -i 's|ports.ubuntu.com|mirrors.aliyun.com|g' /etc/apt/sources.list

# Base deps + Rust + Node in a stable layer for caching
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        libevent-dev \
        libgmp-dev \
        libsodium-dev \
        m4 \
        nasm \
        pkg-config \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 https://sh.rustup.rs -sSf | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

FROM base AS builder

# Ensure Rust is in PATH for this stage
ENV PATH="/root/.cargo/bin:${PATH}"

# Verify/install Rust in builder stage
RUN if [ ! -f /root/.cargo/bin/cargo ]; then \
        echo "Rust not found, installing..." && \
        curl --proto '=https' --tlsv1.2 https://sh.rustup.rs -sSf | sh -s -- -y; \
    else \
        echo "Rust already installed: $(cargo --version 2>/dev/null || /root/.cargo/bin/cargo --version)"; \
    fi

WORKDIR /opt/rapidsnark

RUN git clone -b ${RAPIDSNARK_BRANCH} ${RAPIDSNARK_REPO} . \
    && git submodule update --init

RUN ./build_pistache.sh \
    && if [ "$(uname -m)" = "aarch64" ]; then \
         ./build_gmp.sh aarch64 && \
         make prover-server; \
       else \
         ./build_gmp.sh host && \
         make prover-server; \
       fi \
    && cp package/bin/proverServer /usr/local/bin/proverServer

# Build circom (cached layer - rarely changes)
RUN git clone --depth 1 https://github.com/iden3/circom.git /opt/circom \
    && cd /opt/circom \
    && /root/.cargo/bin/cargo build --release \
    && cp target/release/circom /usr/local/bin/circom \
    && chmod +x /usr/local/bin/circom

# Clone circuits-v2 and generate circuit files (cached layer)
RUN git clone --depth 1 https://github.com/Railgun-Privacy/circuits-v2.git /opt/circuits-v2 \
    && cd /opt/circuits-v2 \
    && npm install \
    && node /opt/circuits-v2/scripts/generate_circuits

# Compile circuit with circom (depends on RAPIDSNARK_CIRCUIT arg)
RUN CIRCUIT_FILE="/opt/circuits-v2/src/generated/${RAPIDSNARK_CIRCUIT}.circom" \
    && [ -f "$CIRCUIT_FILE" ] \
    && /usr/local/bin/circom --r1cs --sym --wasm --c --O2 "$CIRCUIT_FILE" --output /opt/rapidsnark/build

# Build witness generator with ARM64 assembly optimizations
RUN cd "/opt/rapidsnark/build/${RAPIDSNARK_CIRCUIT}_cpp" \
    && if [ "$(uname -m)" = "aarch64" ]; then \
         echo "ARM64: building witness generator with assembly optimizations" && \
         echo "Installing ffiasm dependencies (Node.js 22)..." && \
         curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
         apt-get update && apt-get install -y nodejs && \
         npm install -g ffiasm && \
         echo "Generating ARM64 assembly with ffiasm..." && \
         npx ffiasm \
           /opt/rapidsnark/build/${RAPIDSNARK_CIRCUIT}_cpp/fr.asm \
           /opt/rapidsnark/build/${RAPIDSNARK_CIRCUIT}_cpp/fr_raw_arm64.s \
           -f \
           -p aarch64 \
           -l debug && \
         echo "Building C++ witness generator with assembly..." && \
         sed -i 's|CFLAGS=-std=c++11 -O3 -I.|CFLAGS=-std=c++11 -O3 -I. -I../../depends/json/single_include|' Makefile && \
         make USELIBBACKTRACE=0 && \
         cp "${RAPIDSNARK_CIRCUIT}" "/opt/rapidsnark/build/${RAPIDSNARK_CIRCUIT}" && \
         cp "${RAPIDSNARK_CIRCUIT}.dat" "/opt/rapidsnark/build/${RAPIDSNARK_CIRCUIT}.dat" && \
         echo "✓ ARM64 witness generator built with assembly optimizations"; \
       else \
         echo "x86: building witness generator with native ASM" && \
         sed -i 's|CFLAGS=-std=c++11 -O3 -I.|CFLAGS=-std=c++11 -O3 -I. -I../../depends/json/single_include|' Makefile && \
         make && \
         cp "${RAPIDSNARK_CIRCUIT}" "/opt/rapidsnark/build/${RAPIDSNARK_CIRCUIT}" && \
         cp "${RAPIDSNARK_CIRCUIT}.dat" "/opt/rapidsnark/build/${RAPIDSNARK_CIRCUIT}.dat"; \
       fi

# Generate zkey inside container (no host mount needed)
RUN npm install -g snarkjs \
    && mkdir -p /opt/rapidsnark/zkeys \
    && cd /opt/rapidsnark \
    && curl -L -o ptau.ptau "https://storage.googleapis.com/zkevm/ptau/powersOfTau28_hez_final_18.ptau" \
    && snarkjs groth16 setup /opt/rapidsnark/build/${RAPIDSNARK_CIRCUIT}.r1cs ptau.ptau /opt/rapidsnark/zkeys/${RAPIDSNARK_CIRCUIT}.zkey \
    && snarkjs zkey export verificationkey /opt/rapidsnark/zkeys/${RAPIDSNARK_CIRCUIT}.zkey /opt/rapidsnark/zkeys/${RAPIDSNARK_CIRCUIT}.vkey.json \
    && rm ptau.ptau

FROM base AS runtime

WORKDIR /opt/rapidsnark

COPY --from=builder /opt/rapidsnark /opt/rapidsnark
COPY --from=builder /usr/local/bin/proverServer /usr/local/bin/proverServer
COPY --from=builder /opt/rapidsnark/depends/pistache/build/src/libpistache* /usr/local/lib/
COPY --from=builder /opt/rapidsnark/package/lib/librapidsnark.so /usr/local/lib/

RUN ldconfig

ENV RAPIDSNARK_CIRCUIT=${RAPIDSNARK_CIRCUIT}

EXPOSE 8080

# Use internal zkeys (built inside container)
CMD ["/bin/bash", "-lc", "/usr/local/bin/proverServer 8080 /opt/rapidsnark/zkeys/${RAPIDSNARK_CIRCUIT}.zkey"]
